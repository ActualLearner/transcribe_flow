# Copy to .env for local development. NEVER commit .env.

# --- Django ---
SECRET_KEY=change-me-generate-a-real-one
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset locally to use SQLite. In prod (Render), set to the Neon URL:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- Providers (ADR-006) ---
# groq | fake  — 'fake' needs no API key and is the default for local dev/tests
TRANSCRIPTION_PROVIDER=fake
SUMMARY_PROVIDER=fake
# Required only when a provider is set to 'groq'. Get one free at console.groq.com
GROQ_API_KEY=
# Optional model overrides (defaults per ADR-006)
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# GROQ_SUMMARY_MODEL=openai/gpt-oss-120b

# --- Uploads (PRD: 25MB cap, enforced client AND server side) ---
# MAX_UPLOAD_MB=25

# --- Async-lite jobs (ADR-007) ---
# Worker threads sharing the process-local executor
# JOB_EXECUTOR_MAX_WORKERS=2
# Set to true ONLY for tests — runs jobs synchronously in-process
# JOBS_INLINE=false
